{
  "manifest_version": 3,
  "name": "MakeBeeps",
  "version": "1.0.0",
  "description": "Convert BeepBox JSON files to MakeCode Arcade format and paste into your project",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://arcade.makecode.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://arcade.makecode.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
